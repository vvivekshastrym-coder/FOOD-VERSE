// Prisma schema for FoodVerse

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  name            String
  phone           String?
  role            String         @default("CUSTOMER") // CUSTOMER, RESTAURANT_OWNER, RESTAURANT_STAFF, RIDER, ADMIN, CS_AGENT
  avatar          String?
  fcmToken        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  addresses       Address[]
  preferences     Preference?
  consentRecords  ConsentRecord[]
  orders          Order[]
  carts           Cart[]
  reviews         Review[]
  disputes        Dispute[]
  flavorProfile   FlavorProfile?
  loyaltyEntries  LoyaltyLedger[]
  subscription    UserSubscription?
  supportTickets  SupportTicket[]
  sessions        Session[]
  ownedRestaurants Restaurant[]  @relation("OwnerRestaurants")
  staffAt         RestaurantStaff[]
  deliveryTasks   DeliveryTask[]
  foodRoomsHosted FoodRoom[]     @relation("HostRooms")
  roomMemberships RoomMember[]
}

model Session {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   @default("Home") // Home, Work, Other
  addressLine  String
  landmark     String?
  city         String   @default("Bengaluru")
  postalCode   String   @default("560001")
  latitude     Float    @default(12.9716)
  longitude    Float    @default(77.5946)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Preference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryPreference  String   @default("ALL") // ALL, VEG, VEGAN, GLUTEN_FREE, HALAL
  maxBudget          Float?
  ecoPackagingOptIn  Boolean  @default(true)
  allergies          String?  // JSON string or comma-separated: Peanuts, Dairy, Gluten, Soy
  notificationEmails Boolean  @default(true)
  notificationSMS    Boolean  @default(true)
  notificationPush   Boolean  @default(true)
}

model ConsentRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String   // FLAVOR_DNA, LOCATION_TRACKING, MARKETING, COOKIES
  granted     Boolean  @default(true)
  ipAddress   String?
  timestamp   DateTime @default(now())
}

model Restaurant {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  description        String?
  cuisineType        String              @default("North Indian, Continental")
  address            String
  city               String              @default("Bengaluru")
  latitude           Float               @default(12.9716)
  longitude          Float               @default(77.5946)
  phone              String
  email              String
  fssaiNumber        String              @default("11223344556677")
  gstNumber          String              @default("29AAAAA0000A1Z5")
  hygieneRating      Float               @default(4.8) // Out of 5.0
  isOpen             Boolean             @default(true)
  openingTime        String              @default("11:00 AM")
  closingTime        String              @default("11:00 PM")
  avgPreparationTime Int                 @default(25) // minutes
  deliveryRadiusKm   Float               @default(8.5)
  commissionRate     Float               @default(15.0) // 15%
  rating             Float               @default(4.6)
  reviewCount        Int                 @default(0)
  isVerified         Boolean             @default(true)
  isSponsored        Boolean             @default(false) // Honest ranking disclosure
  sponsoredLabel     String?             // e.g. "Featured Partner"
  heroImage          String?
  logoImage          String?
  ownerId            String?
  owner              User?               @relation("OwnerRestaurants", fields: [ownerId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  menus              Menu[]
  staff              RestaurantStaff[]
  verification       BusinessVerification?
  orders             Order[]
  menuItems          MenuItem[]
  antiWasteDeals     AntiWasteDeal[]
  reviews            Review[]
  ledgerEntries      FinancialLedgerEntry[]
  ioTDevices         IoTDevice[]
  foodRooms          FoodRoom[]
}

model RestaurantStaff {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String     @default("CHEF") // CHEF, MANAGER, CASHIER
  permissions  String     @default("ORDER_UPDATE,MENU_TOGGLE")
  createdAt    DateTime   @default(now())
}

model BusinessVerification {
  id                 String     @id @default(uuid())
  restaurantId       String     @unique
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  fssaiDocUrl        String?
  gstDocUrl          String?
  bankAccountDetails String?
  status             String     @default("APPROVED") // PENDING, APPROVED, REJECTED
  reviewerNotes      String?
  verifiedAt         DateTime?  @default(now())
}

model Menu {
  id           String         @id @default(uuid())
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String         @default("Main Menu")
  isActive     Boolean        @default(true)
  categories   MenuCategory[]
  createdAt    DateTime       @default(now())
}

model MenuCategory {
  id        String     @id @default(uuid())
  menuId    String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String     // e.g., Starters, Bowls, Burgers, Pizzas, Desserts, Beverages
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId          String
  category            MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                String
  description         String
  price               Float
  discountedPrice     Float?
  imageUrl            String?
  isVeg               Boolean            @default(false)
  isAvailable         Boolean            @default(true)
  preparationTimeMin  Int                @default(20)
  calories            Int                @default(450)
  proteinG            Float              @default(18.0)
  carbsG              Float              @default(45.0)
  fatG                Float              @default(12.0)
  allergenInfo        String             @default("None disclosed")
  servingSize         String             @default("Serves 1 (Approx 380g)")
  
  // Signature Pillar 1: True-Size Promise
  trueSizeVerified    Boolean            @default(false)
  verificationStatus  String             @default("UNVERIFIED") // VERIFIED, PARTIAL, UNVERIFIED
  portionWeightG      Float?
  portionDimensions   String?            // e.g. "18cm dia x 6cm height"
  trueSizePhotoUrl    String?
  verifiedBy          String?
  verifiedAt          DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  assets              DishAsset[]
  ingredientToggles   IngredientToggle[]
  portionVariants     PortionVariant[]
  inventory           Inventory?
  antiWasteDeals      AntiWasteDeal[]
  orderItems          OrderItem[]
  cartItems           CartItem[]
  creatorMenuItems    CreatorMenuItem[]
}

model DishAsset {
  id                String   @id @default(uuid())
  menuItemId        String
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modelGlbUrl       String?  // URL to optimized 3D GLB model
  usdzUrl           String?  // Apple AR QuickLook asset
  posterImageUrl    String?
  polyCount         Int      @default(12500)
  textureResolution String   @default("1024x1024")
  scaleRatio        Float    @default(1.0)
  isVerified        Boolean  @default(false)
  version           Int      @default(1)
  foodShapeType     String   @default("bowl") // burger, pizza, bowl, drink, dessert
  primaryColor      String   @default("#e76f51")
  secondaryColor    String   @default("#f4a261")
  createdAt         DateTime @default(now())
}

model IngredientToggle {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // e.g. Extra Cheese, Grilled Mushrooms, Jalapenos
  extraPrice Float    @default(0.0)
  isDefault  Boolean  @default(false)
  removable  Boolean  @default(true)
  meshName   String?  // 3D mesh identifier
}

model PortionVariant {
  id          String   @id @default(uuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String   // Regular, Medium, Large
  scaleFactor Float    @default(1.0) // 3D scaling factor: 0.85, 1.0, 1.25
  price       Float
  weightG     Float?
  dimensions  String?
}

model Inventory {
  id                 String   @id @default(uuid())
  menuItemId         String   @unique
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  currentStock       Int      @default(100)
  lowStockThreshold  Int      @default(10)
  trackStock         Boolean  @default(true)
  isAvailable        Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model AntiWasteDeal {
  id                String   @id @default(uuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId        String
  menuItem          MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  originalPrice     Float
  dealPrice         Float
  availableQuantity Int      @default(5)
  claimedCount      Int      @default(0)
  expiresAt         DateTime
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model Cart {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String?
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CartItem {
  id                 String   @id @default(uuid())
  cartId             String
  cart               Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId         String
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variantId          String?
  quantity           Int      @default(1)
  selectedAddons     String?  // JSON string
  customInstructions String?
  unitPrice          Float
}

// Signature Pillar 3: Food Room Group Ordering
model FoodRoom {
  id           String       @id @default(uuid())
  code         String       @unique // 6-digit room code e.g. "FDV882"
  hostId       String
  host         User         @relation("HostRooms", fields: [hostId], references: [id])
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  status       String       @default("OPEN") // OPEN, LOCKED, CHECKING_OUT, ORDERED, EXPIRED
  spendingLimit Float?
  splitType    String       @default("ITEM_BASED") // EQUAL, ITEM_BASED
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members      RoomMember[]
  items        RoomItem[]
}

model RoomMember {
  id         String     @id @default(uuid())
  foodRoomId String
  foodRoom   FoodRoom   @relation(fields: [foodRoomId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  name       String
  isHost     Boolean    @default(false)
  joinedAt   DateTime   @default(now())
  items      RoomItem[]
  votes      RoomVote[]
}

model RoomItem {
  id         String     @id @default(uuid())
  foodRoomId String
  foodRoom   FoodRoom   @relation(fields: [foodRoomId], references: [id], onDelete: Cascade)
  memberId   String
  member     RoomMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  quantity   Int        @default(1)
  price      Float
  votes      RoomVote[]
}

model RoomVote {
  id         String     @id @default(uuid())
  roomItemId String
  roomItem   RoomItem   @relation(fields: [roomItemId], references: [id], onDelete: Cascade)
  memberId   String
  member     RoomMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  vote       Int        @default(1) // +1 or -1
}

// Signature Pillar 5: Kitchen-to-Door Story
model Order {
  id                      String       @id @default(uuid())
  orderNumber             String       @unique
  userId                  String
  user                    User         @relation(fields: [userId], references: [id])
  restaurantId            String
  restaurant              Restaurant   @relation(fields: [restaurantId], references: [id])
  status                  String       @default("PLACED")
  // PLACED -> ACCEPTED -> PREPARING -> PLATING -> PACKED -> READY_FOR_PICKUP -> PICKED_UP -> OUT_FOR_DELIVERY -> DELIVERED (or CANCELLED, REFUNDED)
  
  subtotal                Float
  discount                Float        @default(0.0)
  deliveryFee             Float        @default(35.0)
  platformFee             Float        @default(5.0)
  gstAmount               Float        @default(0.0)
  totalAmount             Float
  paymentMethod           String       @default("UPI") // UPI, CARD, NETBANKING, COD
  paymentStatus           String       @default("PAID") // PENDING, PAID, FAILED, REFUNDED
  
  deliveryAddress         String
  deliveryCity            String       @default("Bengaluru")
  deliveryLat             Float        @default(12.9716)
  deliveryLng             Float        @default(77.5946)
  deliveryInstructions    String?
  otpCode                 String       @default("4921")
  
  estimatedPrepMinutes    Int          @default(20)
  estimatedDeliveryMinutes Int         @default(15)
  estimatedArrival        DateTime?
  actualDeliveredAt       DateTime?
  
  isEcoDelivery           Boolean      @default(true)
  carbonOffsetKg          Float        @default(0.42)

  items                   OrderItem[]
  events                  OrderEvent[]
  deliveryTask            DeliveryTask?
  payments                Payment[]
  refunds                 Refund[]
  disputes                Dispute[]
  ledgerEntries           FinancialLedgerEntry[]
  reviews                 Review[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id])
  name               String
  quantity           Int      @default(1)
  unitPrice          Float
  selectedAddons     String?
  customInstructions String?
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  actorId   String?
  actorRole String   @default("SYSTEM") // SYSTEM, RESTAURANT, RIDER, CUSTOMER, ADMIN
  note      String?
  timestamp DateTime @default(now())
}

model DeliveryTask {
  id             String    @id @default(uuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId        String?
  rider          User?     @relation(fields: [riderId], references: [id])
  status         String    @default("ASSIGNED") // OFFERED, ACCEPTED, AT_RESTAURANT, PICKED_UP, DELIVERED, CANCELLED
  earningsAmount Float     @default(65.0)
  distanceKm     Float     @default(3.8)
  startLat       Float     @default(12.9716)
  startLng       Float     @default(77.5946)
  currentLat     Float     @default(12.9716)
  currentLng     Float     @default(77.5946)
  updatedAt      DateTime  @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId String   @unique
  gateway       String   @default("RAZORPAY_SANDBOX")
  amount        Float
  currency      String   @default("INR")
  status        String   @default("SUCCESS") // INITIATED, SUCCESS, FAILED, REFUNDED
  rawResponse   String?
  createdAt     DateTime @default(now())
  refunds       Refund[]
}

model Refund {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id])
  amount        Float
  reason        String
  status        String   @default("APPROVED") // REQUESTED, APPROVED, PROCESSED, REJECTED
  reviewerId    String?
  notes         String?
  createdAt     DateTime @default(now())
}

// Signature Pillar 1: True-Size Dispute Flow
model Dispute {
  id               String    @id @default(uuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  type             String    @default("TRUE_SIZE_MISMATCH") // TRUE_SIZE_MISMATCH, MISSING_ITEM, QUALITY_DEFECT, LATE_DELIVERY, OTHER
  description      String
  evidencePhotoUrl String?
  status           String    @default("OPEN") // OPEN, UNDER_REVIEW, APPROVED, REJECTED
  refundAmount     Float?
  resolutionNote   String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
}

model FinancialLedgerEntry {
  id           String      @id @default(uuid())
  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id])
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  type         String      // ORDER_PAYMENT, RESTAURANT_PAYOUT, PLATFORM_COMMISSION, DELIVERY_FEE_PAYOUT, REFUND_DEBIT
  amount       Float
  balanceAfter Float
  reference    String
  createdAt    DateTime    @default(now())
}

// Signature Pillar 4: Flavor DNA
model FlavorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spicy       Int      @default(65) // 0 - 100
  sweet       Int      @default(30)
  sour        Int      @default(40)
  umami       Int      @default(80)
  crunch      Int      @default(70)
  richness    Int      @default(55)
  dietaryTags String   @default("High Protein, Low Sugar")
  consentedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreatorMenu {
  id            String            @id @default(uuid())
  creatorName   String
  creatorAvatar String?
  title         String            // e.g. "Bangalore Late Night Cravings"
  description   String
  badge         String            @default("Verified Foodie")
  isApproved    Boolean           @default(true)
  likesCount    Int               @default(142)
  items         CreatorMenuItem[]
  createdAt     DateTime          @default(now())
}

model CreatorMenuItem {
  id            String      @id @default(uuid())
  creatorMenuId String
  creatorMenu   CreatorMenu @relation(fields: [creatorMenuId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model LoyaltyLedger {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points       Int
  type         String   // EARNED, REDEEMED, EXPIRED
  referenceId  String?
  balanceAfter Int
  createdAt    DateTime @default(now())
}

model UserSubscription {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planName     String   @default("FoodVerse Gold")
  status       String   @default("ACTIVE")
  startsAt     DateTime @default(now())
  expiresAt    DateTime
  freeDelivery Boolean  @default(true)
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String
  discountType  String    @default("PERCENTAGE") // PERCENTAGE, FLAT
  discountValue Float     @default(20.0) // 20% or ₹50
  minOrderValue Float     @default(299.0)
  maxDiscount   Float     @default(100.0)
  expiresAt     DateTime
  usageLimit    Int       @default(1000)
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
}

model Review {
  id                   String     @id @default(uuid())
  orderId              String     @unique
  order                Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rating               Float      @default(5.0)
  comment              String?
  foodPhotos           String?
  replyFromRestaurant  String?
  createdAt            DateTime   @default(now())
}

model SupportTicket {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String?
  subject       String
  message       String
  priority      String   @default("NORMAL") // LOW, NORMAL, URGENT
  status        String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  agentResponse String?
  createdAt     DateTime @default(now())
}

model IoTDevice {
  id              String          @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String          // e.g. "Smart Thermal Cold Bag #4"
  deviceType      String          @default("THERMAL_BAG") // FRIDGE, OVEN, THERMAL_BAG
  status          String          @default("ONLINE")
  lastCalibration DateTime        @default(now())
  lastTemperature Float           @default(4.2) // Celsius
  isAlerting      Boolean         @default(false)
  updatedAt       DateTime        @updatedAt
  readings        SensorReading[]
}

model SensorReading {
  id           String    @id @default(uuid())
  deviceId     String
  device       IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  temperature  Float
  batteryLevel Int       @default(92)
  recordedAt   DateTime  @default(now())
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  description    String
  isEnabled      Boolean  @default(true)
  rolloutPercent Int      @default(100)
  dependencies   String?  // e.g. "WEBXR,RAZORPAY_API_KEY"
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  role           String?
  action         String   // e.g. REFUND_APPROVED, RESTAURANT_SUSPENDED, FLAG_TOGGLED
  targetResource String
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())
}
